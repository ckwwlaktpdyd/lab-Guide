# Supabase — 실제 값은 .env.local 에 넣는다 (git 추적 안 됨)
# 대시보드: Project Settings → API

VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# anon / publishable 키. RLS로 보호되므로 브라우저에 노출되어도 되는 값이다.
# service_role 키는 절대 여기에 넣지 말 것 — RLS를 우회한다.
VITE_SUPABASE_ANON_KEY=<anon-key>

# 1로 두면 Supabase 없이 인메모리 목업으로 돈다. 백엔드가 멈춰도 포트폴리오 링크가 살아 있게 하는 안전장치.
# VITE_MOCK=1
